# ===== データの保存先 =====
# Vercel では Storage → Upstash for Redis をプロジェクトに接続すると、次の2つが自動で設定されます。
# （未設定の場合、ローカルでは data/ フォルダ、Vercel では一時フォルダに保存されます）
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Upstash のコンソールから直接作成した場合はこちらの名前でも構いません
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# 1つの Redis を複数サイトで共有する場合のキー接頭辞（任意）
# STORAGE_PREFIX=tsukiakari

# ===== WebRTC TURN サーバー（本番で通話を安定させるために推奨） =====
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
